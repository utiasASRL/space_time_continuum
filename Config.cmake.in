@PACKAGE_INIT@

# spacetime package configuration: find_package(spacetime) provides the targets
# spacetime::estimator, spacetime::interface (the thread-free interface layer),
# spacetime::interfaces (every built interface, see <spacetime/interface/Interfaces.hpp>)
# and, if built, spacetime::standalone (spacetime_INTERFACE_STANDALONE), spacetime::ros2 and
# spacetime::rviz (spacetime_INTERFACE_ROS2, need a sourced ROS2 distribution) and
# spacetime::visualizer (spacetime_VISUALIZER).

include(CMakeFindDependencyMacro)

set(spacetime_VISUALIZER @Visualizer@)
set(spacetime_VISUALIZER_BACKEND "@VisualizerBackend@")
set(spacetime_INTERFACE_STANDALONE @InterfaceStandalone@)
set(spacetime_INTERFACE_MUJOCO @InterfaceMujoco@)
set(spacetime_INTERFACE_ROS2 @InterfaceROS2@)
# Compile flags spacetime was built with. -march=native changes Eigen's alignment, so
# projects linking spacetime (and GTSAM) must match it.
set(spacetime_MARCH_NATIVE @MarchNative@)

find_dependency(Eigen3 3.4 NO_MODULE)
find_dependency(jsoncpp)
find_dependency(GTSAM)
if(spacetime_INTERFACE_STANDALONE)
    find_dependency(Threads)
endif()
if(spacetime_INTERFACE_ROS2)
    find_dependency(rclcpp)
    find_dependency(tf2_ros)
    find_dependency(tf2_msgs)
    find_dependency(geometry_msgs)
    find_dependency(visualization_msgs)
endif()
if(spacetime_VISUALIZER)
    find_dependency(VTK 9.3)
    find_dependency(Qt6 COMPONENTS Core Gui Xml Network Widgets OpenGLWidgets)
endif()

if(NOT TARGET spacetime::estimator)
    include("${CMAKE_CURRENT_LIST_DIR}/spacetimeTargets.cmake")
endif()

check_required_components(spacetime)
